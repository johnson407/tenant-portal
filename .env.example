# Copy to .env.local (never commit .env*) and fill in real values.

# Secret used to sign session cookies (HS256). Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# Landlord password for the admin area. Generate with:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Bcrypt hashes of each room's 10-character access code (rooms A-E).
# Hash a plaintext code with: node scripts/hash-codes.mjs --code-into=a
# (plaintext codes must never be committed - only these hashes belong here)
ROOM_CODE_HASH_A=
ROOM_CODE_HASH_B=
ROOM_CODE_HASH_C=
ROOM_CODE_HASH_D=
ROOM_CODE_HASH_E=

# Local development only. In production, Vercel KV injects these automatically:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
